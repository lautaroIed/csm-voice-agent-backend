# Port the server listens on
PORT=3000
TIMEZONE=Europe/Madrid

# Retell: the API key also verifies webhook signatures
RETELL_API_KEY=
# Only calls from this agent are forwarded. Leave empty to forward every agent.
RETELL_AGENT_ID=

# Telegram (optional if email is configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (optional if Telegram is configured). SMTP_SECURE: starttls | ssl | none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma separated
SMTP_TO=

# Comma separated channels to log instead of send, for testing: telegram,email
DRY_RUN=
