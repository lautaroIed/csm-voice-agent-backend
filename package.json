{
  "name": "csm-voice-agent-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Receives Retell call webhooks for the CSM voice agent and forwards each recado to Telegram and email.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.1.7",
    "retell-sdk": "^6.2.8"
  }
}
